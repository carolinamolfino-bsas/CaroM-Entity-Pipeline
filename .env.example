# Copiá este archivo como .env y completá tus claves. NUNCA subas .env a GitHub.

# Proveedor: openai | anthropic
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Opcional: servidor compatible con OpenAI. Vacío = API oficial de OpenAI.
# Para Ollama local (gratis):  OPENAI_BASE_URL=http://localhost:11434/v1
#                              OPENAI_API_KEY=ollama   (cualquier texto: Ollama no la valida)
#                              OPENAI_MODEL=qwen2.5:7b (debe soportar tools)
OPENAI_BASE_URL=

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Parámetros (opcionales, validados con Pydantic) ---
LLM_TEMPERATURE=0          # 0 a 2. Bajo = extracción más consistente
LLM_MAX_TOKENS=1024        # límite inicial; se duplica solo si la respuesta se trunca
LLM_TIMEOUT=60             # segundos por request
LLM_MAX_RETRIES=2          # reintentos del SDK ante red / 429 / 5xx
LLM_OUTPUT_RETRIES=3       # intentos de .with_retry() ante JSON inválido o incompleto
LLM_MAX_TOKENS_CAP=4096    # tope al duplicar max_tokens si la respuesta se trunca
LLM_MAX_CONCURRENCY=5      # textos procesados en simultáneo

# Modelo de respaldo (.with_fallbacks): auto | none | openai | anthropic
# auto = usa el otro proveedor sólo si su API key está cargada
LLM_FALLBACK_PROVIDER=auto

# DEBUG muestra finish_reason y uso de tokens de cada respuesta
LOG_LEVEL=INFO
